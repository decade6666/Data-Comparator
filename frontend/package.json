{
  "name": "dataset-comparator-ui",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postbuild": "grep -Eq '(src|href)=\"(\\./assets/|/[^\"]+/assets/|https?://[^\"]+/assets/)' dist/index.html && ! grep -Eq '(src|href)=\"/assets/' dist/index.html || { echo 'dist uses invalid asset paths (base regression)'; exit 1; }",
    "test": "vitest run",
    "lint": "eslint --ext .js,.vue src",
    "format": "prettier --write \"src/**/*.{js,vue}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.13.2",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.25",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.2.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
